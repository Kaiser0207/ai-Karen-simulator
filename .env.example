# === AI 奧客應對演練 環境變數範本 ===
# 用法:複製這個檔成 .env,再填入你自己的 key。
#       cp .env.example .env
# .env 已被 .gitignore 忽略,不會被 commit 進 git。

# 是否使用 mock 奧客大腦(免 API key)。
# Phase 1 設 1;接真 LLM 後設 0。
OKEKE_USE_MOCK=1

# LLM 供應商:groq 或 gemini
LLM_PROVIDER=groq

# Groq(免費額度,推薦)→ 申請:https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini(備選)→ 申請:https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 模型名稱(可留預設)
CUSTOMER_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile

# STT 語音輸入(faster-whisper)
STT_MODEL=medium      # tiny/base/small/medium/large-v3
STT_DEVICE=cpu        # cpu 或 cuda
STT_COMPUTE=int8      # CPU 用 int8;GPU 用 float16
STT_WARMUP=1          # 1=網頁啟動就把模型預載到裝置(第一次錄音不卡)
